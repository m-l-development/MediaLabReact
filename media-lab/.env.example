# ConnectHub – lokal utvikling. Kopier til .env.local (aldri i Git) og fyll inn verdiene for connecthub-dev.
# Bare OFFENTLIGE verdier: prosjekt-URL og publiseringsnøkkel (sb_publishable_…). Aldri hemmelige nøkler.
# Lokalt kan aldri peke mot produksjon – bygget stoppes hvis URL-en er produksjonens.
CONNECTHUB_SUPABASE_URL=
CONNECTHUB_SUPABASE_PUBLISHABLE_KEY=
